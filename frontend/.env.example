# ═══ FRONTEND ENV (set di Vercel → Project → Settings → Environment Variables) ═══

# URL backend FastAPI (WAJIB — pakai https di produksi)
VITE_API_BASE_URL=https://api-domain-anda.com

# URL situs marketing (untuk tombol artikel eksternal)
VITE_MARKETING_SITE_URL=https://medsign-ai.vercel.app/

# Channel YouTube untuk section Video Tutorial di Beranda
VITE_YOUTUBE_TUTORIAL_URL=https://www.youtube.com/@medsignai

# CATATAN:
# - Semua variabel VITE_* di-inject saat BUILD — ubah env = redeploy.
# - Backend juga perlu mengizinkan domain Vercel Anda di MEDSIGN_CORS_ORIGINS.
