# ═══ BACKEND ENV (jangan di-commit! file .env di-gitignore) ═══

# ── KEAMANAN (WAJIB di produksi — jangan pakai default!) ──
# Secret untuk sign JWT — ganti dengan string acak panjang
MEDSIGN_JWT_SECRET=ganti-dengan-string-acak-panjang
# Kunci enkripsi NIK pasien — ganti & JANGAN hilangkan (data tak bisa didekripsi lagi)
MEDSIGN_ENCRYPTION_KEY=ganti-dengan-kunci-acak-panjang

# ── CORS: domain frontend yang diizinkan (pisahkan dengan koma) ──
MEDSIGN_CORS_ORIGINS=http://localhost:3001,https://medsign-ai.vercel.app

# ── Supabase (opsional — kosongkan untuk SQLite lokal) ──
SUPABASE_URL=
SUPABASE_KEY=
