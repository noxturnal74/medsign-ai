# MedSign AI — Backend Environment Variables
# Copy file ini ke .env dan isi dengan nilai nyata

# OpenAI API Key (wajib untuk AI Sentence Refinement di production/Vercel)
# Dapatkan di: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Model yang digunakan (default: gpt-4o-mini — murah, cepat, cukup untuk NLG medis)
OPENAI_MODEL=gpt-4o-mini
